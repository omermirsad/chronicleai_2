# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Settings
VITE_APP_URL=http://localhost:5173
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=true

# Google Gemini API (for local development only - production uses Supabase Edge Function)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Sentry Error Monitoring (optional)
VITE_SENTRY_DSN=

# Stripe Configuration (for subscription payments)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Stripe Price IDs (create these in your Stripe dashboard)
# Pro Plan
VITE_STRIPE_PRO_PRICE_ID=price_xxx_monthly_pro
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_xxx_yearly_pro

# Premium Plan
VITE_STRIPE_PREMIUM_PRICE_ID=price_xxx_monthly_premium
VITE_STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxx_yearly_premium

# Supabase Edge Functions Environment Variables
# These should be set in your Supabase project settings, not in .env
# - GEMINI_API_KEY: Your Google Gemini API key
# - GEMINI_MODEL: (optional) Model to use (default: gemini-2.0-flash)
# - STRIPE_SECRET_KEY: Your Stripe secret key
# - STRIPE_WEBHOOK_SECRET: Your Stripe webhook signing secret
# - SUPABASE_URL: Your Supabase project URL
# - SUPABASE_SERVICE_ROLE_KEY: Your Supabase service role key
