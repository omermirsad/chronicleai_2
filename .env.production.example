# Production Environment Variables
# Copy this file to .env.production and fill in the actual values

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application Settings (REQUIRED)
VITE_APP_URL=https://chronicle-ai.app
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=true

# Google Gemini API (OPTIONAL - for local dev only, production uses Edge Function)
# Leave empty in production - API key should be in Supabase Edge Function secrets
VITE_GEMINI_API_KEY=

# Sentry Error Monitoring (RECOMMENDED)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Stripe Configuration (REQUIRED for payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (REQUIRED for subscriptions)
# Get these from your Stripe dashboard after creating products
VITE_STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# Stripe AI Call Pack (OPTIONAL)
VITE_STRIPE_AI_CALL_PACK_25_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# IMPORTANT: Supabase Edge Function Secrets
# ============================================================================
# These should be set in your Supabase project dashboard under "Edge Functions"
# NOT in this .env file!
#
# Required Edge Function Secrets:
# - GEMINI_API_KEY: Your Google Gemini API key
# - GEMINI_MODEL: gemini-2.0-flash (or gemini-2.5-flash)
# - STRIPE_SECRET_KEY: Your Stripe secret key (sk_live_xxxxx)
# - STRIPE_WEBHOOK_SECRET: Your Stripe webhook signing secret
# - RESEND_API_KEY: Your Resend API key for sending emails
# - SUPABASE_URL: Your Supabase project URL
# - SUPABASE_SERVICE_ROLE_KEY: Your Supabase service role key
# ============================================================================

# Production Build Settings
NODE_ENV=production
