{
  "name": "chronicle-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "analyze": "cross-env ANALYZE=true vite build",
    "analyze:bundle": "vite-bundle-visualizer",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:functions:deploy": "supabase functions deploy --no-verify-jwt",
    "supabase:functions:serve": "supabase functions serve",
    "supabase:migration:new": "supabase migration new",
    "supabase:migration:up": "supabase migration up",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "deploy:vercel": "npm run build:prod && vercel --prod",
    "deploy:netlify": "npm run build:prod && netlify deploy --prod",
    "validate:env": "ts-node scripts/validate-env.ts",
    "verify:db": "ts-node scripts/verify-database.ts",
    "pre-deploy": "npm run lint && npm run type-check && npm run validate:env && npm run build:prod",
    "security:check": "pnpm audit --audit-level=moderate",
    "security:fix": "pnpm audit --fix",
    "build:mobile": "npm run build",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "mobile:ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
    "mobile:android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "cap:copy": "npx cap copy",
    "cap:copy:ios": "npx cap copy ios",
    "cap:copy:android": "npx cap copy android",
    "cap:update": "npx cap update",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "prepare": "husky install",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@google/generative-ai": "^0.24.1",
    "@sentry/react": "^8.48.0",
    "@stripe/stripe-js": "^5.7.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "isomorphic-dompurify": "^2.20.1",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.3.3",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.15.4",
    "resend": "^6.4.2",
    "workbox-window": "^7.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "^1.40.1",
    "@sentry/vite-plugin": "^2.22.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "supabase": "^2.59.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.37.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.11",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
